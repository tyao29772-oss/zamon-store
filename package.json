{
  "name": "zamon-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/sync-images.mjs && tsx --require ./scripts/lib/stub-server-only.cjs scripts/report-images.ts",
    "test:foundation": "tsx --require ./scripts/lib/stub-server-only.cjs scripts/test-foundation.ts",
    "smoke": "node scripts/smoke.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "e2e": "node scripts/e2e.mjs",
    "db:check": "node scripts/db-check.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "db:seed-taxonomy": "tsx --require ./scripts/lib/stub-server-only.cjs scripts/db-seed-taxonomy.ts",
    "db:restore": "tsx --require ./scripts/lib/stub-server-only.cjs scripts/db-restore.ts",
    "db:seed-products": "tsx --require ./scripts/lib/stub-server-only.cjs scripts/db-seed-products.ts"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "minisearch": "^7.2.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
