# Saytning to‘liq manzili (sitemap, Telegram xabaridagi havolalar uchun). Oxirida "/" bo‘lmasin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Magazinning Telegram username'i (@ belgisisiz). Brauzerga chiqadi — maxfiy emas.
NEXT_PUBLIC_TELEGRAM_USERNAME=zamon_store_demo

# Faqat server! Hech qachon NEXT_PUBLIC_ prefiksi bilan yozilmaydi.
# Ikkalasi ham to‘ldirilsa, yangi buyurtma bot orqali adminga yuboriladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Admin panel (/admin). Faqat server! Ikkalasi ham to‘ldirilmaguncha admin panelga kirib bo‘lmaydi.
# Parol — kamida 12 belgi, kuchli bo‘lsin. Sessiya kaliti — kamida 32 belgi, masalan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Parol yoki kalit almashtirilsa, barcha ochiq admin sessiyalari bekor bo‘ladi.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase baza (buyurtmalar, statistika). Faqat server! Ikkalasi to‘ldirilmasa, sayt lokal
# .data/ fayllari bilan ishlaydi (Netlify'da saqlanmaydi).
# Project Settings → Data API → Project URL; Project Settings → API Keys → Secret keys (sb_secret_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
