# Saytning to‘liq manzili (sitemap, Telegram xabaridagi havolalar uchun). Oxirida "/" bo‘lmasin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Magazinning Telegram username'i (@ belgisisiz). Brauzerga chiqadi — maxfiy emas.
NEXT_PUBLIC_TELEGRAM_USERNAME=zamon_store_demo

# Faqat server! Hech qachon NEXT_PUBLIC_ prefiksi bilan yozilmaydi.
# Ikkalasi ham to‘ldirilsa, yangi buyurtma bot orqali adminga yuboriladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
